# Application
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------
# PostgreSQL configuration
#
# Option A - preferred for hosted environments such as
# staging/Neon:
# DATABASE_URL=postgresql://username:password@host:5432/database
#
# Option B - local/team development configuration:
# Use the individual DB_* variables below when DATABASE_URL
# is not provided.
# ---------------------------------------------------------

# DATABASE_URL=postgresql://username:password@host:5432/database

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_NAME=forever_hotel
DB_SSL=false

# TypeORM
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ---------------------------------------------------------
# Authentication / authorization
#
# The API Gateway performs centralized JWT validation.
# FDS also verifies Bearer JWTs on protected endpoints as
# defense in depth.
#
# JWT_SECRET must match the Authentication Service /
# API Gateway HS256 signing secret.
#
# Never commit a real JWT secret.
#
# JWT_SECRET is mandatory for staging and production.
# ---------------------------------------------------------

# Example only - replace locally with a secure secret:
# JWT_SECRET=replace_with_a_secure_secret_at_least_32_characters

JWT_ISSUER=forever-hotel-auth

# ---------------------------------------------------------
# RabbitMQ messaging
#
# RabbitMQ is optional during local backend work until a
# broker is intentionally started.
#
# When enabled, RABBITMQ_URL is required.
#
# Never commit real broker credentials.
# ---------------------------------------------------------

RABBITMQ_ENABLED=false

# Example only:
# RABBITMQ_URL=amqp://rabbitmq_username:rabbitmq_password@localhost:5672

RABBITMQ_EXCHANGE=forever.events

# Maximum number of unacknowledged escalation messages
# delivered to this FDS consumer at one time.
RABBITMQ_PREFETCH=10

# Number of retry attempts before a repeatedly failing
# task-escalation message is sent to the DLQ.
RABBITMQ_MAX_RETRIES=3

# Delay before a failed message is returned from the retry
# queue to the main escalation queue.
RABBITMQ_RETRY_DELAY_MS=5000

# ---------------------------------------------------------
# Worker Management System integration
#
# FDS uses synchronous REST calls for operations requiring
# an immediate WKMS response.
#
# Never commit real integration credentials.
# ---------------------------------------------------------

WKMS_INTEGRATION_ENABLED=false

# Example only:
# WKMS_BASE_URL=http://localhost:3002

WKMS_REQUEST_TIMEOUT_MS=5000