# Example for local development with the shared API Gateway and direct FDS Socket.IO.
# For deployment, configure browser-reachable HTTPS/WSS URLs at build time.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/fds
NEXT_PUBLIC_WS_URL=http://127.0.0.1:4200
# The secure same-origin Central Auth session BFF is not implemented yet.
NEXT_PUBLIC_FDS_CENTRAL_AUTH_ENABLED=false
